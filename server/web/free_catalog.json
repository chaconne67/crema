        { "match": "^gemini-[0-9.]+-flash-lite$", "tier": 1, "scarcity": "common", "vision": true },
        { "match": "^gemini-[0-9.]+-flash$", "tier": 2, "scarcity": "rare", "vision": true }
      ]
    },
    {
      "id": "groq",
      "name": "Groq",
